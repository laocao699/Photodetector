end_node_model

begin_node_model "basenodemodel"
COMMAND contact_node_model -device "bjt" -contact "base" -display_type "scalar" -name "basenodemodel" -equation "(-base_bias + Potential + (ifelse ((NetDoping > 0), (-log(((1.000000000000000e-10 + (5.000000000000000e-01 * abs((NetDoping + pow((pow(NetDoping,2) + (4 * pow(NIE,2))),5.000000000000000e-01))))) * pow(NIE,(-1)))) * V_t), (V_t * log(((1.000000000000000e-10 + (5.000000000000000e-01 * abs((-NetDoping + pow((pow(NetDoping,2) + (4 * pow(NIE,2))),5.000000000000000e-01))))) * pow(NIE,(-1))))))));"
end_node_model

