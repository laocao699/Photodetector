begin_node_model "Acceptors"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "Acceptors" -equation "(base_doping * erfc((((-5.000000000000000e-01 * base_width) - base_center + x) * pow(base_hdiff,(-1)))) * erfc(((-(-base_center + (5.000000000000000e-01 * base_width) + x)) * pow(base_hdiff,(-1)))) * erfc(((y - base_depth) * pow(base_vdiff,(-1)))));"
end_node_model

begin_node_model "AtContactNode"
BUILTIN
end_node_model

begin_node_model "ContactNSurfaceNormal_x"
DATAPARENT "SurfaceArea"
end_node_model

begin_node_model "ContactNSurfaceNormal_y"
DATAPARENT "SurfaceArea"
end_node_model

begin_node_model "ContactSurfaceArea"
DATAPARENT "SurfaceArea"
end_node_model

begin_node_model "DEG"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "DEG" -equation "0;"
end_node_model

begin_node_model "Donors"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "Donors" -equation "(collector_doping + (emitter_doping * erfc((((-5.000000000000000e-01 * emitter_width) - emitter_center + x) * pow(emitter_hdiff,(-1)))) * erfc(((-(-emitter_center + (5.000000000000000e-01 * emitter_width) + x)) * pow(emitter_hdiff,(-1)))) * erfc(((y - emitter_depth) * pow(emitter_vdiff,(-1))))) + (sub_collector_doping * erfc((((-5.000000000000000e-01 * sub_collector_width) - sub_collector_center + x) * pow(sub_collector_hdiff,(-1)))) * erfc(((-(-sub_collector_center + (5.000000000000000e-01 * sub_collector_width) + x)) * pow(sub_collector_hdiff,(-1)))) * erfc(((-(y - sub_collector_depth)) * pow(sub_collector_vdiff,(-1))))));"
end_node_model

begin_node_model "EC"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "EC" -equation "(-Affinity - Potential - (pow(2,(-1)) * DEG));"
end_node_model

begin_node_model "EC:Potential"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "EC:Potential" -equation "(-1 - (pow(2,(-1)) * DEG:Potential));"
end_node_model

begin_node_model "EFN"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "EFN" -equation "(EC + (V_t * log((Electrons * pow(NC,(-1))))));"
end_node_model

begin_node_model "EFN:Electrons"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "EFN:Electrons" -equation "(((((((-pow(NC,(-2)) * NC:Electrons) * Electrons) + pow(NC,(-1))) * pow((Electrons * pow(NC,(-1))),(-1))) * V_t) + (log((Electrons * pow(NC,(-1)))) * V_t:Electrons)) + EC:Electrons);"
end_node_model

begin_node_model "EFN:Potential"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "EFN:Potential" -equation "(((((((-pow(NC,(-2)) * NC:Potential) * Electrons) + (pow(NC,(-1)) * Electrons:Potential)) * pow((Electrons * pow(NC,(-1))),(-1))) * V_t) + (log((Electrons * pow(NC,(-1)))) * V_t:Potential)) + EC:Potential);"
end_node_model

begin_node_model "EFP"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "EFP" -equation "(EV - (log((Holes * pow(NV,(-1)))) * V_t));"
end_node_model

begin_node_model "EFP:Holes"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "EFP:Holes" -equation "((-(((((-pow(NV,(-2)) * NV:Holes) * Holes) + pow(NV,(-1))) * pow((Holes * pow(NV,(-1))),(-1))) * V_t) - (log((Holes * pow(NV,(-1)))) * V_t:Holes)) + EV:Holes);"
end_node_model

begin_node_model "EFP:Potential"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "EFP:Potential" -equation "((-(((((-pow(NV,(-2)) * NV:Potential) * Holes) + (pow(NV,(-1)) * Holes:Potential)) * pow((Holes * pow(NV,(-1))),(-1))) * V_t) - (log((Holes * pow(NV,(-1)))) * V_t:Potential)) + EV:Potential);"
end_node_model

begin_node_model "EG"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "EG" -equation "(EG300 - DEG + (EGALPH * ((pow(300,2) * pow((300 + EGBETA),(-1))) - (pow((T + EGBETA),(-1)) * pow(T,2)))));"
end_node_model

begin_node_model "EI"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "EI" -equation "(5.000000000000000e-01 * ((V_t * log((NC * pow(NV,(-1))))) + EC + EV));"
end_node_model

begin_node_model "EI:Potential"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "EI:Potential" -equation "(5.000000000000000e-01 * (((((((-pow(NV,(-2)) * NV:Potential) * NC) + (pow(NV,(-1)) * NC:Potential)) * pow((NC * pow(NV,(-1))),(-1))) * V_t) + (log((NC * pow(NV,(-1)))) * V_t:Potential)) + EC:Potential + EV:Potential));"
end_node_model

begin_node_model "EV"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "EV" -equation "(-EG + (DEG * pow(2,(-1))) + EC);"
end_node_model

begin_node_model "EV:Potential"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "EV:Potential" -equation "(-EG:Potential + (pow(2,(-1)) * DEG:Potential) + EC:Potential);"
end_node_model

begin_node_model "ElectronGeneration"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "ElectronGeneration" -equation "(-q * USRH);"
end_node_model

begin_node_model "ElectronGeneration:Electrons"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "ElectronGeneration:Electrons" -equation "(-q * USRH:Electrons);"
end_node_model

begin_node_model "ElectronGeneration:Holes"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "ElectronGeneration:Holes" -equation "(-q * USRH:Holes);"
end_node_model

