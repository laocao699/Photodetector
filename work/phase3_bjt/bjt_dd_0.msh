begin_node_model "PotentialIntrinsicCharge"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "PotentialIntrinsicCharge" -equation "(-q * IntrinsicCharge);"
end_node_model

begin_node_model "PotentialIntrinsicCharge:Potential"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "PotentialIntrinsicCharge:Potential" -equation "(-q * IntrinsicCharge:Potential);"
end_node_model

begin_node_model "PotentialNodeCharge"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "PotentialNodeCharge" -equation "(-q * kahan3(Holes, (-Electrons), NetDoping));"
end_node_model

begin_node_model "PotentialNodeCharge:Electrons"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "PotentialNodeCharge:Electrons" -equation "(-q * (-1 + Holes:Electrons + NetDoping:Electrons));"
end_node_model

begin_node_model "PotentialNodeCharge:Holes"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "PotentialNodeCharge:Holes" -equation "(-q * (1 - Electrons:Holes + NetDoping:Holes));"
end_node_model

