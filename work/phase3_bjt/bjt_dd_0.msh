begin_node_model "SurfaceArea"
BUILTIN
end_node_model

begin_node_model "Tn"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "Tn" -equation "(T * pow(300,(-1)));"
end_node_model

begin_node_model "USRH"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "USRH" -equation "(((Electrons * Holes) - pow(NIE,2)) * pow(((taup * (Electrons + n1)) + (taun * (Holes + p1))),(-1)));"
end_node_model

begin_node_model "USRH:Electrons"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "USRH:Electrons" -equation "(((((Electrons * Holes:Electrons) + Holes) - (2 * NIE * NIE:Electrons)) * pow(((taup * (Electrons + n1)) + (taun * (Holes + p1))),(-1))) + (((Electrons * Holes) - pow(NIE,2)) * (-(taup + (taun * Holes:Electrons)) * pow(((taup * (Electrons + n1)) + (taun * (Holes + p1))),(-2)))));"
end_node_model

begin_node_model "USRH:Holes"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "USRH:Holes" -equation "(((((Electrons:Holes * Holes) + Electrons) - (2 * NIE * NIE:Holes)) * pow(((taup * (Electrons + n1)) + (taun * (Holes + p1))),(-1))) + (((Electrons * Holes) - pow(NIE,2)) * (-(taun + (taup * Electrons:Holes)) * pow(((taup * (Electrons + n1)) + (taun * (Holes + p1))),(-2)))));"
end_node_model

begin_node_model "V_t"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "V_t" -equation "((k * T) * pow(q,(-1)));"
end_node_model

begin_node_model "basenodeelectrons"
COMMAND contact_node_model -device "bjt" -contact "base" -display_type "scalar" -name "basenodeelectrons" -equation "(Electrons - (ifelse ((NetDoping > 0), (1.000000000000000e-10 + (5.000000000000000e-01 * abs((NetDoping + pow((pow(NetDoping,2) + (4 * pow(NIE,2))),5.000000000000000e-01))))), (pow(NIE,2) * pow((1.000000000000000e-10 + (5.000000000000000e-01 * abs((-NetDoping + pow((pow(NetDoping,2) + (4 * pow(NIE,2))),5.000000000000000e-01))))),(-1))))));"
end_node_model

begin_node_model "basenodeelectrons:Electrons"
COMMAND contact_node_model -device "bjt" -contact "base" -display_type "scalar" -name "basenodeelectrons:Electrons" -equation "1;"
end_node_model

