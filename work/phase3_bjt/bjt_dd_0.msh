begin_node_model "IntrinsicCharge"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "IntrinsicCharge" -equation "kahan3(IntrinsicHoles, (-IntrinsicElectrons), NetDoping);"
end_node_model

begin_node_model "IntrinsicCharge:Potential"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "IntrinsicCharge:Potential" -equation "(-IntrinsicElectrons:Potential + IntrinsicHoles:Potential + NetDoping:Potential);"
end_node_model

begin_node_model "IntrinsicElectrons"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "IntrinsicElectrons" -equation "(NIE * exp((Potential * pow(V_t,(-1)))));"
end_node_model

begin_node_model "IntrinsicElectrons:Potential"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "IntrinsicElectrons:Potential" -equation "((((((-pow(V_t,(-2)) * V_t:Potential) * Potential) + pow(V_t,(-1))) * exp((Potential * pow(V_t,(-1))))) * NIE) + (exp((Potential * pow(V_t,(-1)))) * NIE:Potential));"
end_node_model

begin_node_model "IntrinsicHoles"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "IntrinsicHoles" -equation "(pow(NIE,2) * pow(IntrinsicElectrons,(-1)));"
end_node_model

begin_node_model "IntrinsicHoles:Potential"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "IntrinsicHoles:Potential" -equation "(((-pow(IntrinsicElectrons,(-2)) * IntrinsicElectrons:Potential) * pow(NIE,2)) + ((2 * NIE * NIE:Potential) * pow(IntrinsicElectrons,(-1))));"
end_node_model

begin_node_model "LogNetDoping"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "LogNetDoping" -equation "(asinh((Donors - (pow(2,(-1)) * Acceptors))) * pow(log(10),(-1)));"
end_node_model

begin_node_model "NC"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "NC" -equation "(NC300 * pow((T * pow(300,(-1))),1.500000000000000e+00));"
end_node_model

begin_node_model "NCharge"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "NCharge" -equation "(q * Electrons);"
end_node_model

begin_node_model "NCharge:Electrons"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "NCharge:Electrons" -equation "q;"
end_node_model

begin_node_model "NIE"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "NIE" -equation "(exp(((-EG) * pow((2 * V_t),(-1)))) * exp(DEG) * pow((NC * NV),5.000000000000000e-01));"
end_node_model

begin_node_model "NSurfaceNormal_x"
DATAPARENT "SurfaceArea"
end_node_model

begin_node_model "NSurfaceNormal_y"
DATAPARENT "SurfaceArea"
end_node_model

begin_node_model "NTOT"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "NTOT" -equation "(Donors + Acceptors);"
end_node_model

begin_node_model "NV"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "NV" -equation "(NV300 * pow((T * pow(300,(-1))),1.500000000000000e+00));"
end_node_model

begin_node_model "NetDoping"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "NetDoping" -equation "(Donors - Acceptors);"
end_node_model

begin_node_model "NodeVolume"
BUILTIN
end_node_model

begin_node_model "PCharge"
COMMAND node_model -device "bjt" -region "bjt" -display_type "scalar" -name "PCharge" -equation "(-q * Holes);"
